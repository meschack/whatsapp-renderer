{
  "expo": {
    "name": "Kinsay",
    "slug": "whatsapp-renderer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "whatsapprenderer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.godwingbewezoun.whatsapprenderer",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "ZIP Archive",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.zip-archive", "com.pkware.zip-archive"]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "versionCode": 3,
      "predictiveBackGestureEnabled": false,
      "package": "com.godwingbewezoun.whatsapprenderer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-v2.png",
        "backgroundColor": "#06101C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-zip-compressed"
            },
            {
              "scheme": "file",
              "mimeType": "application/x-zip-compressed"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06101C",
          "dark": {
            "backgroundColor": "#06101C"
          }
        }
      ],
      "expo-image",
      "expo-asset",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kinsay to use a photo as a chat wallpaper.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f562e070-1f99-4012-9c60-389b1e0c68fb"
      }
    }
  }
}
