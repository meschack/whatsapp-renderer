{
  "expo": {
    "name": "whatsapp-renderer",
    "slug": "whatsapp-renderer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whatsapprenderer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.godwingbewezoun.whatsapprenderer"
    },
    "android": {
      "versionCode": 3,
      "predictiveBackGestureEnabled": false,
      "package": "com.godwingbewezoun.whatsapprenderer"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-image",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f562e070-1f99-4012-9c60-389b1e0c68fb"
      }
    }
  }
}
